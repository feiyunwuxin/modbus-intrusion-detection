# ============================================================
# SCADA 入侵检测项目 .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# --- Claude Code 配置 ---
.claude/

# --- 第三方源码(整个 repo 不应入版本) ---
netron-main/
tflite-micro/

# --- PyTorch 模型权重 (大,二进制,通常不提交) ---
*.pt
*.pth

# --- sklearn 模型 (二进制,joblib) ---
*.joblib

# --- 原始数据集 (有 csv 转换脚本,不必入库) ---
IanArffDataset.arff
IanArffDataset.csv
# F32/Raw1 两份字节完全相同 (md5 9dfc3d4c...), 只保留 F32 一份入库
IanArffDatasetRaw1.csv

# --- 课题交付压缩包 (不入库) ---
Issue.rar

# --- 陈旧工程快照 (2026-10-15 的旧副本, 186 MB) ---
# 里面的 full_int8 后端已改名为 int8, 现存 MCU/Core/{Src,Inc}/ch32_inference_int8.*
# TestH743/H743test/ 是 MCU/ 的旧副本 (含重复的 Drivers)
TestH743/

# --- 大型数据文件 ---
*.npy
*.npz
*.h5
*.hdf5
*.parquet

# --- 临时工作脚本 ---
_worker_*.py
_worker_*.log
_worker_retrain*.py
_worker_*.log

# --- 临时预测 / 元数据 ---
predictions_*.csv
processed_meta_*.json
*_extracted.npz

# --- 日志 ---
*.log
*.tmp

# --- 临时扫描头文件 (量化脚本中间产物) ---
i8_*.h
*_sweep_tmp.h

# ============================================================
# MCU / Keil 构建产物 (2026-11-02)
# ============================================================
# 4 个 target 的编译输出目录 (.axf/.hex/.o/.d/.map)
MCU/MDK-ARM/H743test/
MCU/MDK-ARM/H743test_INT8/
MCU/MDK-ARM/H743test_HYBRID/
MCU/MDK-ARM/H743test_TFLM/
# uVision 调试会话状态 (per-user)
MCU/MDK-ARM/*.uvguix.*
# uVision 调试序列日志
MCU/MDK-ARM/H743test_Sequences_*.log
# uVision 工程手工备份 (调试过程中的快照, 噪声)
MCU/MDK-ARM/*.bak
MCU/MDK-ARM/*.bak2
MCU/MDK-ARM/*.bak_int8
MCU/MDK-ARM/*.good
MCU/MDK-ARM/*.disabled
# 例外: 各 target 的构建日志 (证明 0 error, 体积小)
!/MCU/MDK-ARM/build_*.log
!/MCU/MDK-ARM/b_*.log

# ============================================================
# MCU 串口回放原始日志 (logs/ 共 377 MB; summary .txt 已入库)
# ============================================================
logs/*.csv
# 例外: 报告正文引用的 3 份全量回放原始日志 (可审计)
!/logs/test_20261027-232828_auto-40ms.csv
!/logs/test_20261027-212756_auto-40ms.csv
!/logs/test_20261021-003650_auto-40ms.csv

# --- 系统 ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- IDE ---
.idea/
.vscode/
*.iml

# ============================================================
# 例外(以下文件即使匹配上面的规则也要提交):
# ============================================================
# - ONNX 备份(跨平台部署用): !*.onnx
# - 模型权重 .h(部署用):     !*.h
# - 推理引擎 .c:             !*.c
# - 报告/日志 .md:           !*.md
# - 训练/量化脚本 .py:       !*.py(但 _worker_*.py 仍被排除)